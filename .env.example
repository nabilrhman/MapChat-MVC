# Copy to .env and fill in. On a host, set these in its dashboard instead.

# Public address of the site: links inside emails, the check that a request
# comes from the site itself, Secure cookies when https://, and the default
# VAPID_SUBJECT
APP_URL=http://localhost:8080
# Show an error's details on the page; false on a real site, where they're logged
SHOW_ERRORS=true

# Database (docker-compose sets DB_HOST=db for you)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mapchat
DB_USER=root
DB_PASSWORD=mapchat
# Set to true for hosted MySQL that requires TLS
DB_SSL=false
# The CA certificates DB_SSL checks against (default /etc/ssl/certs/ca-certificates.crt)
DB_SSL_CA=

# Random secret for hashing login/reset tokens: openssl rand -hex 32
SECRET_KEY=change-me

# Email. On a host, leave empty and new accounts are active right away, or
# set an SMTP address, e.g. smtp://user:pass@smtp.example.com:587
# On Render's free plan SMTP ports are blocked, so use Brevo's API instead:
# brevo+api://API_KEY@default
# Locally, docker compose sends everything to Mailpit (http://localhost:8025)
# unless you set this.
# Without email, a password reset says it couldn't send one.
MAILER_DSN=
# Who emails come from (default MapChat <no-reply@localhost>). Brevo needs an
# address on a domain verified with it.
MAIL_FROM="MapChat <no-reply@example.com>"

# IP location: ipapi.co, ipwho.is and GeoJS are tried in turn. With a key,
# ipstack is tried last (optional). Its free plan is plain http, with the key
# in the address.
IPSTACK_API_KEY=
# Used in place of any private or reserved IP, in any environment. Locally
# every visitor has one, so this puts them on the map. Leave empty on a host.
DEV_FAKE_IP=8.8.8.8

# The demo people's day starts at midnight here (default America/Toronto)
DEMO_TIMEZONE=
# Locally, play the demo day faster to watch it: 60 plays a day in 24 minutes
DEMO_SPEED=
# For the README's tour: demo people kept away from, or always in, the room,
# by first name, comma separated (DEMO_AWAY=emily). Leave empty on a host.
DEMO_AWAY=
DEMO_HERE=

# The MapChat account greets visitors to a quiet room either way; with a
# Groq API key (free at console.groq.com) it also chats back, in the room and
# in private, and the mic button's recordings are written out with Whisper
GROQ_API_KEY=
# Defaults to openai/gpt-oss-120b
MAPCHAT_MODEL=
# Cerebras API key (free at cloud.cerebras.ai): Cerebras writes the replies
# with the same model when Groq is busy or down. Voice messages stay with Groq
CEREBRAS_API_KEY=

# Where the chat socket listens inside the container, behind Apache's /ws
# (default 127.0.0.1 and 8090)
CHAT_SOCKET_HOST=
CHAT_SOCKET_PORT=
# Seconds someone still shows online after their last chat page closes (default 10)
CHAT_PRESENCE_GRACE_SECONDS=
# Seconds between the chat socket's checks for logged-out pages to close (default 15)
CHAT_SESSION_CHECK_SECONDS=

# Continue with Google on the login page, which makes the account the first
# time. Make an OAuth client (Web application) at
# console.cloud.google.com/apis/credentials, with APP_URL/login/google/callback
# as its redirect URI. Without both, the login page doesn't offer Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Photo uploads go straight from the browser to your Cloudinary account, with
# an unsigned upload preset. Both are required for uploads; with either empty,
# uploads are off and the profile says so.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Web Push: notifications for private messages and mentions even with MapChat
# closed. Make a key pair once and keep it; a new pair drops every browser's
# subscription. Without them, notifications only come while a tab is open:
# docker compose run --rm app php -r 'require "vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about this server; defaults to APP_URL
# (https:// or mailto:)
VAPID_SUBJECT=

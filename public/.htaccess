# Remove the question mark from the request but maintain the query string
RewriteEngine On
RewriteBase /

# The site's pictures were in /res/; sent emails and cached link previews
# still point there
RewriteRule ^res/(.*)$ /images/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?$1 [L,QSA]

# Cache static files for a week; CSS and JS links carry ?v=N, bumped on change
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
